generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TRAINER
  INSTITUTE_ADMIN
  PLATFORM_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  APPROVED
  REJECTED
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CourseStatus {
  DRAFT
  PENDING
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BookingTrigger {
  NONE
  MANUAL
  AUTO
}

enum SessionType {
  ONLINE
  IN_PERSON
  HYBRID
}

enum SessionStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  PRELIMINARY
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
}

enum BookingMode {
  SINGLE
  BATCH
  RECURRING
}

enum RoomBookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REJECTED
  REFUNDED
  FAILED
}

enum NotificationType {
  PAYMENT
  ENROLLMENT
  SESSION
  ANNOUNCEMENT
  BOOKING
  SYSTEM
  REVIEW
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  CANCEL
}

model User {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  password   String
  phone      String?
  role       UserRole   @default(STUDENT)
  status     UserStatus @default(PENDING)
  avatar     String?
  instituteId String?   @map("institute_id")
  deletedAt  DateTime?  @map("deleted_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  // Relations
  trainerProfile     TrainerProfile?
  institute          Institute?    @relation(fields: [instituteId], references: [id])
  coursesTaught      Course[]      @relation("CourseTrainer")
  enrollments        Enrollment[]
  wishlists          Wishlist[]
  sentAnnouncements  Announcement[] @relation("AnnouncementSender")
  notifications      Notification[]
  auditLogs          AuditLog[]    @relation("AuditPerformer")
  requestedBookings  RoomBooking[] @relation("BookingRequester")
  approvedBookings   RoomBooking[] @relation("BookingApprover")
  reviewedPayments   Payment[]     @relation("PaymentReviewer")

  @@map("users")
}

model TrainerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique @map("user_id")
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                String?            @db.Text
  cvUrl              String?            @map("cv_url")
  specialties        String[]
  certificatesUrls   String[]           @map("certificates_urls")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  rejectionReason    String?            @db.Text @map("rejection_reason")

  @@map("trainer_profiles")
}

model Institute {
  id                   String             @id @default(cuid())
  name                 String
  description          String?            @db.Text
  email                String
  phone                String?
  address              String?
  logo                 String?
  website              String?
  licenseNumber        String?            @map("license_number")
  licenseDocumentUrl   String?            @map("license_document_url")
  verificationStatus   VerificationStatus @default(PENDING) @map("verification_status")
  rejectionReason      String?            @db.Text @map("rejection_reason")
  deletedAt            DateTime?          @map("deleted_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  // Relations
  users       User[]
  courses     Course[]
  rooms       Room[]

  @@map("institutes")
}

model CourseCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  courses     Course[]

  @@map("course_categories")
}

model Course {
  id               String         @id @default(cuid())
  title            String
  description      String         @db.Text
  shortDescription String?        @map("short_description")
  price            Decimal        @db.Decimal(10, 2)
  duration         Int
  startDate        DateTime       @map("start_date")
  endDate          DateTime       @map("end_date")
  minStudents      Int?           @map("min_students")
  maxStudents      Int?           @map("max_students")
  status           CourseStatus   @default(DRAFT)
  bookingTrigger   BookingTrigger @default(NONE) @map("booking_trigger")
  image            String?
  prerequisites    String?        @db.Text
  objectives       String[]
  tags             String[]
  trainerId        String         @map("trainer_id")
  instituteId      String?        @map("institute_id")
  categoryId       String?        @map("category_id")
  deactivatedAt    DateTime?      @map("deactivated_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  trainer       User           @relation("CourseTrainer", fields: [trainerId], references: [id])
  institute     Institute?     @relation(fields: [instituteId], references: [id])
  category      CourseCategory? @relation(fields: [categoryId], references: [id])
  sessions      Session[]
  enrollments   Enrollment[]
  wishlists     Wishlist[]
  announcements Announcement[]

  @@map("courses")
}

model Session {
  id          String        @id @default(cuid())
  startTime   DateTime      @map("start_time")
  endTime     DateTime      @map("end_time")
  type        SessionType
  status      SessionStatus @default(SCHEDULED)
  meetingLink String?       @map("meeting_link")
  courseId    String        @map("course_id")

  // Relations
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  roomBookings RoomBooking[]

  @@map("sessions")
}

model Enrollment {
  id                 String           @id @default(cuid())
  enrolledAt         DateTime         @default(now()) @map("enrolled_at")
  status             EnrollmentStatus @default(ACTIVE)
  progress           Int              @default(0)
  cancellationReason String?          @db.Text @map("cancellation_reason")
  studentId          String           @map("student_id")
  courseId           String           @map("course_id")
  deletedAt          DateTime?        @map("deleted_at")

  // Relations
  student   User   @relation(fields: [studentId], references: [id])
  course    Course @relation(fields: [courseId], references: [id])
  payments  Payment[]

  @@unique([studentId, courseId])
  @@map("enrollments")
}

model Wishlist {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  studentId String   @map("student_id")
  courseId  String   @map("course_id")

  // Relations
  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
  @@map("wishlists")
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  message     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  scheduledAt DateTime? @map("scheduled_at")
  sentAt      DateTime? @map("sent_at")
  courseId    String?  @map("course_id")
  senderId    String   @map("sender_id")

  // Relations
  course Course? @relation(fields: [courseId], references: [id])
  sender User   @relation("AnnouncementSender", fields: [senderId], references: [id])

  @@map("announcements")
}

model Notification {
  id             String           @id @default(cuid())
  type           NotificationType
  isRead         Boolean          @default(false) @map("is_read")
  createdAt      DateTime         @default(now()) @map("created_at")
  relatedEntityId String?         @map("related_entity_id")
  userId         String           @map("user_id")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  entityName  String      @map("entity_name")
  entityId    String      @map("entity_id")
  description String?     @db.Text
  performedBy String?     @map("performed_by")
  performedAt DateTime    @default(now()) @map("performed_at")

  // Relations
  performer User? @relation("AuditPerformer", fields: [performedBy], references: [id])

  @@map("audit_logs")
}

model Room {
  id          String   @id @default(cuid())
  name        String
  capacity    Int
  pricePerHour Decimal @db.Decimal(10, 2) @map("price_per_hour")
  facilities  String[]
  image       String?
  isActive    Boolean  @default(true) @map("is_active")
  instituteId String   @map("institute_id")

  // Relations
  institute   Institute   @relation(fields: [instituteId], references: [id])
  bookings    RoomBooking[]

  @@map("rooms")
}

model RoomBooking {
  id             String           @id @default(cuid())
  batchId        String?          @map("batch_id")
  bookingMode    BookingMode      @default(SINGLE) @map("booking_mode")
  startTime      DateTime         @map("start_time")
  endTime        DateTime         @map("end_time")
  status         RoomBookingStatus @default(PENDING)
  purpose        String?
  notes          String?          @db.Text
  rejectionReason String?         @db.Text @map("rejection_reason")
  totalPrice     Decimal?         @db.Decimal(10, 2) @map("total_price")
  createdAt      DateTime         @default(now()) @map("created_at")
  roomId         String           @map("room_id")
  sessionId      String?          @map("session_id")
  requestedById  String           @map("requested_by_id")
  approvedById   String?          @map("approved_by_id")

  // Relations
  room        Room     @relation(fields: [roomId], references: [id])
  session     Session? @relation(fields: [sessionId], references: [id])
  requestedBy User     @relation("BookingRequester", fields: [requestedById], references: [id])
  approvedBy  User?    @relation("BookingApprover", fields: [approvedById], references: [id])
  payments    Payment[]

  @@map("room_bookings")
}

model Payment {
  id               String        @id @default(cuid())
  amount           Decimal       @db.Decimal(10, 2)
  currency         String
  depositSlipImage String?       @map("deposit_slip_image")
  notes            String?       @db.Text
  status           PaymentStatus @default(PENDING)
  reviewedBy       String?       @map("reviewed_by")
  reviewedAt       DateTime?     @map("reviewed_at")
  rejectionReason  String?       @db.Text @map("rejection_reason")
  createdAt        DateTime      @default(now()) @map("created_at")
  enrollmentId     String?       @map("enrollment_id")
  roomBookingId    String?       @map("room_booking_id")

  // Relations
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id])
  roomBooking  RoomBooking? @relation(fields: [roomBookingId], references: [id])
  reviewer     User?        @relation("PaymentReviewer", fields: [reviewedBy], references: [id])

  @@map("payments")
}
